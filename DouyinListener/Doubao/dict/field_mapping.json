{
  "_meta": {
    "name": "Doubao 抖音直播 protobuf 字段映射字典",
    "version": "1.0.0",
    "proto": ["douyin_live.proto", "douyin_extra.proto"],
    "focus": ["星守护(ResidentGuest/StarGuard)", "会员(VIP/Noble/Subscription)", "礼物榜单(Gift/Ranklist/Contribution)"],
    "conventions": {
      "id": "int64 snowflake id",
      "count": "uint64 累计次数",
      "score": "uint64 榜单分值/音浪/钻石",
      "timestamp": "uint64 秒级 unix ts",
      "displayText": "Text 富文本（key/string_piece/default_pattern 拼接模板）"
    }
  },

  "Common": {
    "_doc": "消息公共头，所有 Push 消息携带",
    "fields": {
      "method":            { "type": "string", "desc": "消息方法名，等同于外层 method，如 WebcastChatMessage" },
      "msgId":             { "type": "uint64", "desc": "消息唯一 ID（snowflake）" },
      "roomId":            { "type": "uint64", "desc": "直播间 ID" },
      "anchorId":          { "type": "uint64", "desc": "主播 ID（=room owner）" },
      "createTime":        { "type": "uint64", "desc": "服务器创建时间（秒）" },
      "sendTime":          { "type": "uint64", "desc": "发送时间（秒）" },
      "isShowMsg":         { "type": "bool",   "desc": "是否前端展示" },
      "isBackground":      { "type": "bool",   "desc": "是否后台/静默消息" },
      "priority":          { "type": "uint32", "desc": "前端展示优先级（数字越大越优先）" },
      "identify":          { "type": "string", "desc": "客户端侧标识" },
      "filter":            { "type": "MessageFilter", "desc": "过滤信息" },
      "describe":          { "type": "string", "desc": "描述文案/系统提示" },
      "displayText":       { "type": "Text",   "desc": "标准展示文案（含模板/pieces）" },
      "foldType":          { "type": "uint32", "desc": "折叠类型 0=不折叠 1=连续合并" },
      "foldCount":         { "type": "uint32", "desc": "合并条数" }
    }
  },

  "User": {
    "_doc": "用户对象，贯穿所有消息",
    "fields": {
      "id":               { "type": "int64",  "desc": "用户 ID" },
      "shortId":          { "type": "int64",  "desc": "抖音号（短 ID）" },
      "nickName":         { "type": "string", "desc": "昵称" },
      "gender":           { "type": "uint32", "desc": "性别 0未知 1男 2女", "enum": {"0":"未知","1":"男","2":"女"} },
      "signature":        { "type": "string", "desc": "个性签名" },
      "level":            { "type": "uint32", "desc": "抖音等级（财富/消费等级）" },
      "birthday":         { "type": "uint64", "desc": "生日时间戳" },
      "telephone":        { "type": "string", "desc": "手机号（脱敏）" },
      "avatarThumb":      { "type": "Image",  "desc": "头像缩略图" },
      "avatarMedium":     { "type": "Image",  "desc": "头像中图" },
      "avatarLarge":      { "type": "Image",  "desc": "头像大图" },
      "verified":         { "type": "bool",   "desc": "是否官方认证" },
      "experience":       { "type": "uint32", "desc": "经验值" },
      "city":             { "type": "string", "desc": "城市" },
      "status":           { "type": "uint32", "desc": "用户状态" },
      "createTime":       { "type": "uint64", "desc": "账号创建时间" },
      "modifyTime":       { "type": "uint64", "desc": "资料修改时间" },
      "secret":           { "type": "uint32", "desc": "隐私级别" },
      "shareQrcodeUri":   { "type": "string", "desc": "个人名片二维码" },
      "payGrade":         { "type": "PayGradeBadge", "desc": "消费等级（付费等级徽章）" },
      "fansClub":         { "type": "FansClub",     "desc": "粉丝团信息" },
      "specialId":        { "type": "string", "desc": "自定义抖音号" },
      "payScore":         { "type": "uint64", "desc": "消费积分" },
      "ticketCount":      { "type": "uint64", "desc": "送出音浪总数" },
      "anchorRoomId":     { "type": "int64",  "desc": "如为主播则其直播间 ID" },
      "userAttr":         { "type": "UserAttr",     "desc": "用户属性（管理员/禁言等）" },
      "ownRoom":          { "type": "Room",         "desc": "自己直播间信息" },
      "badgeImageList":   { "type": "repeated Image", "desc": "佩戴徽章列表" },
      "followInfo":       { "type": "FollowInfo",   "desc": "关注关系" },
      "isNew":            { "type": "bool",   "desc": "是否新用户" }
    }
  },

  "Text": {
    "_doc": "富文本结构，由 key 模板 + 多段 string_piece 构成；key 前缀在 default_pattern 中查找拼接待展示文字",
    "fields": {
      "key":           { "type": "string", "desc": "模板 key（如 live_chat_message_enter_room）" },
      "defaultPattern":{ "type": "string", "desc": "默认展示模板（含 %s 占位）" },
      "defaultContent":{ "type": "string", "desc": "默认已渲染文本（多数情况直接使用）" },
      "pieces":        { "type": "repeated StringPiece", "desc": "占位内容段" }
    }
  },

  "Gift": {
    "_doc": "礼物对象，礼物消息/GiftMessage 与榜单通用",
    "fields": {
      "id":             { "type": "uint64", "desc": "礼物 ID" },
      "name":           { "type": "string", "desc": "礼物名称（玫瑰、嘉年华、宇宙之心等）" },
      "describe":       { "type": "string", "desc": "礼物描述" },
      "diamondCount":   { "type": "uint32", "desc": "单价（钻石数，1 钻石=1 抖币=0.1 元人民币）" },
      "type":           { "type": "uint32", "desc": "礼物类型 1=普通 2=特效 3=粉丝团 4=浪漫 5=专属 6=幸运",
        "enum": {"1":"普通","2":"特效","3":"粉丝团","4":"浪漫","5":"专属","6":"幸运"} },
      "combo":          { "type": "bool",   "desc": "是否支持连击" },
      "icon":           { "type": "Image",  "desc": "礼物图标（列表）" },
      "image":          { "type": "Image",  "desc": "礼物静态大图" },
      "dynamicImage":   { "type": "Image",  "desc": "动态图（WebP/GIF）" },
      "animateEffect":  { "type": "Image",  "desc": "全屏特效动画 SVGA/MP4" },
      "trueGoldImage":  { "type": "Image",  "desc": "真金礼物大图" },
      "primaryEffectId":{ "type": "uint64", "desc": "主特效 ID（关联 WebcastGiftPlayEventMessage.effectId）" },
      "isBoxGift":      { "type": "bool",   "desc": "是否盲盒礼物" },
      "isShowPanel":    { "type": "bool",   "desc": "是否展示礼物面板标记" },
      "isBroadcastGift":{ "type": "bool",   "desc": "是否全站广播礼物（跨直播间横幅）" },
      "isEffect":       { "type": "bool",   "desc": "是否特效礼物" },
      "giftRankScore":  { "type": "uint64", "desc": "送此礼后榜单分值（通常=diamondCount*count）" },
      "notifyAll":      { "type": "bool",   "desc": "是否全屏通知（嘉年华/火箭/宇宙之心）" },
      "region":         { "type": "string", "desc": "地区限定" },
      "recommend":      { "type": "bool",   "desc": "是否推荐位礼物" },
      "tag":            { "type": "string", "desc": "礼物标签（热门/整蛊/豪华等）" },
      "colors":         { "type": "string", "desc": "特效色调" }
    },
    "_value_notes": {
      "diamondCount_to_rmb": "1 钻石 ≈ 0.1 元；1 抖币 ≈ 0.1 元；主播分成约 50%",
      "famous_ids": {
        "533":  "小心心",
        "1":    "玫瑰",
        "2":    "棒棒糖",
        "9":    "Thuglife",
        "23":   "粉丝团灯牌（需加入粉丝团）",
        "539":  "比心兔兔",
        "596":  "爱的纸飞机",
        "104":  "保时捷",
        "248":  "私人飞机",
        "409":  "火箭",
        "484":  "嘉年华（约 3000 元）",
        "906":  "抖音1号（约 10001 元）",
        "762":  "宇宙之心（约 9999 元，需粉丝团 16 级）",
        "1200": "神秘商店礼盒",
        "951":  "点亮粉丝团灯牌"
      }
    }
  },

  "GiftIMPriority": {
    "_doc": "礼物 IM 展示优先级队列",
    "fields": {
      "normalPositionList":   { "type": "repeated uint64", "desc": "普通礼物位置优先级（ID 从小到大）" },
      "priorityPositionList": { "type": "repeated uint64", "desc": "高优礼物位置（大礼物/特效）" },
      "priorityQueueSize":    { "type": "uint64", "desc": "优先级队列长度" },
      "normalQueueSize":      { "type": "uint64", "desc": "普通队列长度" },
      "lastPriorityInterval": { "type": "uint64", "desc": "高优礼物最小间隔(ms)" },
      "lastNormalInterval":   { "type": "uint64", "desc": "普通礼物最小间隔(ms)" }
    }
  },

  "PayGradeBadge": {
    "_doc": "消费等级徽章（直播间右上角显示）",
    "fields": {
      "level":       { "type": "uint64", "desc": "消费等级 1-75" },
      "diamondCount":{ "type": "uint64", "desc": "累计消费钻石数" },
      "curScore":    { "type": "uint64", "desc": "当前等级积分" },
      "levelScore":  { "type": "uint64", "desc": "下一级所需积分" },
      "totalScore":  { "type": "uint64", "desc": "总积分" },
      "gradeName":   { "type": "string", "desc": "等级名（L1/L2/.../L75）" },
      "icon":        { "type": "repeated Image", "desc": "徽章图标" },
      "upgradeIcon": { "type": "repeated Image", "desc": "升级徽章" },
      "background":  { "type": "Image",  "desc": "等级背景条" },
      "newIcon":     { "type": "Image",  "desc": "新版等级图标" }
    },
    "_value_notes": {
      "level_mapping": "60级≈2000万元 65级≈5000万元 70级≈1亿元 75级≈5亿元（约数）"
    }
  },

  "FansClub": {
    "_doc": "粉丝团/灯牌信息",
    "fields": {
      "clubName":       { "type": "string", "desc": "粉丝团名称（如 XXX 的粉丝团）" },
      "level":          { "type": "uint32", "desc": "灯牌等级 1-20（亲密度等级）" },
      "score":          { "type": "uint64", "desc": "当前亲密度" },
      "requireScore":   { "type": "uint64", "desc": "升级所需亲密度" },
      "userFansClubId": { "type": "uint64", "desc": "粉丝团成员 ID" },
      "badge":          { "type": "Image",  "desc": "粉丝团徽章/灯牌" },
      "anchorId":       { "type": "uint64", "desc": "粉丝团对应主播 ID" },
      "type":           { "type": "uint32", "desc": "粉丝团类型 1=普通 2=专属 3=会员团" },
      "lightUp":        { "type": "bool",   "desc": "今天是否点亮灯牌" },
      "lightUpDays":    { "type": "uint64", "desc": "连续点亮天数" }
    }
  },

  "UserAttr": {
    "_doc": "用户在直播间的属性",
    "fields": {
      "isAdmin":       { "type": "bool",   "desc": "是否房管" },
      "isSuperAdmin":  { "type": "bool",   "desc": "是否超管" },
      "isMute":        { "type": "bool",   "desc": "是否被禁言" },
      "isFollower":    { "type": "bool",   "desc": "是否关注主播" },
      "isSubscriber":  { "type": "bool",   "desc": "是否订阅会员" },
      "isNew":         { "type": "bool",   "desc": "是否新关注" }
    }
  },

  "FollowInfo": {
    "_doc": "关注状态",
    "fields": {
      "followingCount":  { "type": "uint64", "desc": "关注数" },
      "followerCount":   { "type": "uint64", "desc": "粉丝数" },
      "followStatus":    { "type": "uint32", "desc": "0=未关注 1=已关注 2=互关", "enum": {"0":"未关注","1":"已关注","2":"互关"} },
      "pushStatus":      { "type": "uint32", "desc": "开播提醒状态" }
    }
  },

  "PublicAreaCommon": {
    "_doc": "公域频道/流量入口信息",
    "fields": {
      "enterFrom":     { "type": "string", "desc": "进入来源 live_strip/recommend/following/hot" },
      "enterMethod":   { "type": "string", "desc": "进入方式 click/auto/slide" },
      "channelId":     { "type": "uint64", "desc": "频道 ID" },
      "trafficSource": { "type": "string", "desc": "流量来源标签" }
    }
  },

  "CommentQualityScore": {
    "_doc": "弹幕质量评分（用于反垃圾与高价值弹幕高亮）",
    "fields": {
      "score":         { "type": "uint32", "desc": "0-100 分" },
      "isHighQuality": { "type": "bool",   "desc": "是否高质量弹幕" },
      "tag":           { "type": "string", "desc": "标签" }
    }
  },

  "Room": {
    "_doc": "直播间基础信息",
    "fields": {
      "id":            { "type": "uint64", "desc": "直播间 ID" },
      "title":         { "type": "string", "desc": "标题" },
      "ownerUserId":   { "type": "uint64", "desc": "主播 ID" },
      "status":        { "type": "uint32", "desc": "2=直播中 4=已结束" },
      "cover":         { "type": "Image",  "desc": "封面" }
    }
  },

  "Image": {
    "_doc": "图片/资源对象，含多种分辨率 URL",
    "fields": {
      "urlList":   { "type": "repeated string", "desc": "URL 列表（CDN 多源）" },
      "uri":       { "type": "string", "desc": "tos 资源 URI（webcast-xxx 前缀）" },
      "height":    { "type": "uint64", "desc": "高度" },
      "width":     { "type": "uint64", "desc": "宽度" },
      "avgColor":  { "type": "string", "desc": "主色调（如 #FFAA00）" },
      "imageType": { "type": "uint32", "desc": "图片类型 1=png 2=jpg 3=webp 4=gif 5=mp4 6=svga" },
      "openWebUrl":{ "type": "string", "desc": "打开网页 URL" },
      "isAnimated":{ "type": "bool",   "desc": "是否动图" }
    }
  },

  "StringPiece": {
    "_doc": "富文本段，支持用户/文字/链接",
    "fields": {
      "type":      { "type": "uint32", "desc": "1=纯文本 2=用户 4=积分/数字 5=链接 7=图标",
        "enum": {"1":"text","2":"user","4":"number","5":"link","7":"icon"} },
      "stringValue": { "type": "string", "desc": "文字内容" },
      "userValue":   { "type": "User",   "desc": "用户引用" },
      "value":       { "type": "string", "desc": "原始值（数字/链接等）" },
      "icon":        { "type": "Image",  "desc": "段前图标" }
    }
  },

  "MessageFilter": {
    "_doc": "消息过滤信息（用户被过滤/敏感词）",
    "fields": {
      "type":         { "type": "uint32", "desc": "过滤类型" },
      "filterReason": { "type": "string", "desc": "过滤原因（敏感词/频率等）" }
    }
  },

  "SendResult": {
    "_doc": "发送结果",
    "fields": {
      "success": { "type": "bool",   "desc": "是否成功" },
      "code":    { "type": "int64",  "desc": "错误码" },
      "message": { "type": "string", "desc": "错误信息" }
    }
  },

  "=== 消息级字段映射（method 为键）===": {},

  "WebcastChatMessage": {
    "_doc": "弹幕/聊天消息（最高频）",
    "method": "WebcastChatMessage",
    "msgId_field": "common.msgId",
    "user_field": "user",
    "text_field": "content",
    "fields": {
      "common":           { "type": "Common", "desc": "公共头" },
      "user":             { "type": "User",   "desc": "发送者" },
      "content":          { "type": "string", "desc": "弹幕文本内容" },
      "roomId":           { "type": "uint64", "desc": "直播间 ID" },
      "priority":         { "type": "uint32", "desc": "优先级（大礼物/高等级用户消息 > 普通）" },
      "rtfContent":       { "type": "Text",   "desc": "富文本" },
      "publicAreaCommon": { "type": "PublicAreaCommon", "desc": "公域信息" },
      "label":            { "type": "Image",  "desc": "标签（高等级提示）" },
      "commentQualityScore": { "type": "CommentQualityScore", "desc": "弹幕评分" },
      "enterRoomByAction":{ "type": "bool",   "desc": "是否随入场动作一起发送" }
    },
    "ui": {
      "template": "{user.nickName}: {content}",
      "highlights": "user.payGrade.level > 30 时金色边框；isAdmin 显示房管图标；fansClub 显示灯牌"
    }
  },

  "WebcastGiftMessage": {
    "_doc": "礼物消息（送礼物，含连击）",
    "method": "WebcastGiftMessage",
    "primary": true,
    "focus": "礼物/榜单",
    "fields": {
      "common":      { "type": "Common", "desc": "公共头" },
      "user":        { "type": "User",   "desc": "送礼用户" },
      "toUser":      { "type": "User",   "desc": "收礼方（通常主播）" },
      "gift":        { "type": "Gift",   "desc": "礼物对象（含 id/name/diamondCount/图标/特效）" },
      "roomId":      { "type": "uint64", "desc": "直播间 ID" },
      "count":       { "type": "uint32", "desc": "本次数量" },
      "comboCount":  { "type": "uint32", "desc": "连击次数（x1/x2/x3...）" },
      "repeatCount": { "type": "uint32", "desc": "重复次数（同用户同礼物连续累计）" },
      "comboId":     { "type": "uint64", "desc": "连击 ID（同一连击唯一标识）" },
      "groupCount":  { "type": "uint32", "desc": "本批合并数量" },
      "remainTier":  { "type": "uint64", "desc": "剩余等级/档位" },
      "batchCompose":{ "type": "bool",   "desc": "是否批量合并显示" },
      "diamondCount":{ "type": "uint32", "desc": "本次礼物总价（=gift.diamondCount * count）" },
      "totalDiamondCount": { "type": "uint64", "desc": "本连击累计总钻石数" },
      "effectDisplay":{ "type": "uint32", "desc": "特效展示位 1=列表 2=半屏 3=全屏" },
      "priority":    { "type": "GiftIMPriority", "desc": "IM 展示优先级队列状态" },
      "text":        { "type": "Text",   "desc": "展示文字（'送出了 {gift.name} x{count}'）" },
      "isDisplayPanel": { "type": "bool", "desc": "是否展示礼物面板" },
      "isFirstSendInRoom": { "type": "bool", "desc": "本直播间首次送此礼物" },
      "isSpecialShot":{ "type": "bool",  "desc": "是否特殊镜头/特效位" },
      "bananaCount": { "type": "uint32", "desc": "香蕉数量（互动礼物）" },
      "screenEffectType": { "type": "uint32", "desc": "全屏特效类型" },
      "sendTime":    { "type": "uint64", "desc": "发送时间（毫秒）" },
      "publicAreaCommon": { "type": "PublicAreaCommon", "desc": "公域信息" },
      "monitorExtra":{ "type": "string", "desc": "风控附加信息" },
      "forceDisplay":{ "type": "bool",   "desc": "是否强制展示" },
      "displayPriority": { "type": "uint32", "desc": "展示优先级" },
      "giftColor":   { "type": "string", "desc": "礼物主题色" },
      "logId":       { "type": "string", "desc": "日志 ID" }
    },
    "ui": {
      "template": "{user.nickName} 送出 {gift.name} x{comboCount}",
      "value_calc": "total_value = gift.diamondCount * count (单位:钻石), rmb ≈ diamondCount * 0.1",
      "combo_rule": "同 comboId 持续累加 comboCount；断开后重置"
    },
    "rank": {
      "description": "送礼后触发 WebcastContributionMessage 更新贡献榜；gift.giftRankScore 为榜单增量",
      "increments": ["WebcastRoomStatsMessage.giftCount", "WebcastContributionMessage.ranks.score"]
    }
  },

  "WebcastLikeMessage": {
    "_doc": "点赞消息（连点批量上报）",
    "method": "WebcastLikeMessage",
    "fields": {
      "common":       { "type": "Common", "desc": "公共头" },
      "user":         { "type": "User",   "desc": "点赞用户" },
      "count":        { "type": "uint64", "desc": "本次点赞数（通常 1-20）" },
      "total":        { "type": "uint64", "desc": "直播间累计点赞数" },
      "roomId":       { "type": "uint64", "desc": "直播间 ID" },
      "displayType":  { "type": "uint32", "desc": "展示类型 1=桃心 2=星型等" },
      "label":        { "type": "Image",  "desc": "点赞标签" },
