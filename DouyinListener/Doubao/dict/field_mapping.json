      "isAdmin":      { "type": "bool",   "desc": "是否管理员发送" },
      "isVisible":    { "type": "bool",   "desc": "是否可见" },
      "compressed":   { "type": "bool",   "desc": "payload 是否 gzip 压缩" }
    },
    "dispatch": "payload 按 method 派发到对应消息类型解析"
  },

